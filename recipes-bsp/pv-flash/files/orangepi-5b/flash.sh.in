#!/bin/sh
# Factory-flash Pantavisor to Orange Pi 5B (RK3588S) eMMC via rkdeveloptool.
#
# Put the board in Maskrom mode first: hold the Maskrom button (next to the
# 3.5 mm jack), plug a USB-C cable from this host into the board's USB-C port,
# release the button after ~2 s. The board must have no bootable SD card
# inserted, or rkdeveloptool may target the SD card instead of eMMC.
#
# Host needs libusb-1.0 (the bundled rkdeveloptool links it dynamically) and
# either a udev rule for Rockchip VID 0x2207 or the sudo used below.
set -e

# Flashing tool: $RKDEVELOPTOOL overrides the bundled ./rkdeveloptool, then
# PATH, so the bundle also works from a container/host that ships its own.
if [ -n "$RKDEVELOPTOOL" ]; then rkdt="$RKDEVELOPTOOL"
elif [ -x ./rkdeveloptool ]; then rkdt=./rkdeveloptool
else rkdt="$(command -v rkdeveloptool)" || { echo "rkdeveloptool not found: set RKDEVELOPTOOL=/path/to/rkdeveloptool" >&2; exit 1; }
fi
# sudo only when not already root (containers usually are, and lack sudo).
[ "$(id -u)" -eq 0 ] && sudo= || sudo=sudo

wic=@WIC@
trap 'rm -f "$wic"' EXIT INT TERM

if [ -f "@WIC_ZST@" ]; then
    echo "Decompressing @WIC_ZST@..."
    zstd -dc "@WIC_ZST@" > "$wic"
elif [ -f "@WIC_GZ@" ]; then
    echo "Decompressing @WIC_GZ@..."
    zcat "@WIC_GZ@" > "$wic"
fi   # else an uncompressed @WIC@ is already in the bundle

echo "Waiting for a Rockchip device in Maskrom mode..."
until $sudo "$rkdt" ld | grep -qi maskrom; do sleep 1; done

$sudo "$rkdt" db loader.bin
sleep 2
$sudo "$rkdt" wl 0 "$wic"
$sudo "$rkdt" rd

echo "Done - the board reboots from eMMC."

uuu_version 1.5.165

# Factory flash for Pantavisor on Colibri iMX6ULL (NAND)
# NAND layout: @MTDPARTS@
# Fastboot buffer: 0x81100000  (CONFIG_FASTBOOT_BUF_ADDR)
# Usage (from inside the extracted bundle directory):
#   sudo ./uuu ./

SDP: boot -f @RECOVERY_IMAGE@
CFG: FB: -vid 0x1b67 -pid 0x4000
# Write U-Boot to u-boot1 (offset 0x80000, 1536KB) and mirror to u-boot2 (offset 0x200000).
# Raw byte offsets bypass the 'ro' partition flag set in the production MTD table.
FB: download -f @UBOOT_NAND@
FB: ucmd nand erase 0x80000 0x180000
FB: ucmd nand write.trimffs 0x81100000 0x80000 ${filesize}
FB: ucmd nand erase 0x200000 0x180000
FB: ucmd nand write.trimffs 0x81100000 0x200000 ${filesize}
# Erase the u-boot-env partition (0x380000, 512KB) so U-Boot falls back to
# its built-in default environment. The CONFIG_BOOTCOMMAND baked in by
# pv.colibri-imx6ull.cfg mounts ubi0:boot and sources /boot/boot.scr; a
# leftover env from a prior image would otherwise run a stale bootcmd.
FB: ucmd nand erase 0x380000 0x80000
# Tell the flashing U-Boot the layout above (its stock table has no fitA/fitB
# and a larger ubi partition); the partition-name commands below use it.
FB: ucmd setenv mtdparts 'mtdparts=@MTDPARTS@'
# pv-uboot-ab only: the BSP FIT of revision 0 goes into the raw fitA partition
# (4 KiB header + FIT, see fitA.img); fitB is left erased for the first update.
# nand write skips bad blocks the same way the boot script's nand read does.
#AB# FB: download -f @FITA_IMG@
#AB# FB[-t 120000]: ucmd nand erase.part fitA
#AB# FB[-t 120000]: ucmd nand write.trimffs 0x81100000 fitA ${filesize}
#AB# FB[-t 120000]: ucmd nand erase.part fitB
# Write UBIFS rootfs to the ubi MTD partition
FB: download -f @UBIFS@
FB[-t 120000]: ucmd nand erase.part ubi
FB: ucmd ubi part ubi
FB: ucmd ubi create boot
FB[-t 300000]: ucmd ubi write 0x81100000 boot ${filesize}
FB: acmd reset
FB: done

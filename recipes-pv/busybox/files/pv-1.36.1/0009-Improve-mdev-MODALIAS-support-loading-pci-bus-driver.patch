 #if ENABLE_FEATURE_MDEV_FOLLOW_X_ROOT
 	if (newrootdev && !(!access(newrootdev, X_OK) && !stat(newrootdev, &s) && (S_IFDIR & s.st_mode))){
@@ -604,8 +608,6 @@ static void make_device(char *device_name, char *path, int operation)
 #endif
 		chdir ("/dev");
 
-	getcwd(wd, PATH_MAX);
-
 	/* Try to read major/minor string.  Note that the kernel puts \n after
 	 * the data, so we don't need to worry about null terminating the string
 	 * because sscanf() will stop at the first nondigit, which \n is.
@@ -614,7 +616,8 @@ static void make_device(char *device_name, char *path, int operation)
 	major = -1;
 	if (operation == OP_add) {
 		strcpy(path_end, "/dev");
-		len = open_read_close(path, path_end + 1, SCRATCH_SIZE - 1);
+		len = open_read_close(path, path_end + 1, PATH_MAX +
+				      SCRATCH_SIZE - path_len - 1);
 		*path_end = '\0';
 		if (len < 1) {
 			if (!ENABLE_FEATURE_MDEV_EXEC)
@@ -631,6 +634,8 @@ static void make_device(char *device_name, char *path, int operation)
 
 	/* Determine device name */
 	if (!device_name) {
+		char *tok = NULL;
+		char *strd = NULL;
 		/*
 		 * There was no $DEVNAME envvar (for example, mdev -s never has).
 		 * But it is very useful: it contains the *path*, not only basename,
@@ -641,20 +646,38 @@ static void make_device(char *device_name, char *path, int operation)
 		 * DEVNAME=snd/controlC0
 		 */
 		strcpy(path_end, "/uevent");
-		len = open_read_close(path, path_end + 1, SCRATCH_SIZE - 1);
+		len = open_read_close(path, path_end + 1, PATH_MAX + SCRATCH_SIZE - path_len - 1);

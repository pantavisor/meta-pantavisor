#!/bin/sh
#
# Helpers shared by the two halves of the pvtest framework:
#
#   - test.docker.sh, the host orchestrator, running on the CI/dev machine
#   - pvtest-run + utils, running inside the tester container
#
# Only context-free helpers belong here. Anything that talks to a target —
# anything calling _pv_exec, or curl against $PVTEST_HOST — stays in utils,
# which also sources this file. In particular utils' pvcontrol/pventer/pvcurl/
# pvtx shadow real commands to route them through $PVTEST_EXEC; sourcing utils
# on the host would silently redirect the host's own commands to the device,
# which is why the split exists at all.

# [<tag>] <epoch> <LEVEL> -- [<source>]: <msg>
#
# tag: the container/device the line is about. The host sets PVTEST_LOG_TAG in a
# subshell handling one appengine/device; the tester binds PVTEST_AE per attach
# and falls back to its own PVTEST_TESTER_NAME for dispatcher-level lines that
# aren't about any one device yet. PVTEST_LOG_HOST is the host's last resort.
# source: set once by each entry point (pvtest-run, test.docker.sh).
pvtest_log() {
	local level=$1; shift
	local line
	line=$(printf '[%s] %s %s -- [%s]: %s' \
		"${PVTEST_LOG_TAG:-${PVTEST_AE:-${PVTEST_TESTER_NAME:-${PVTEST_LOG_HOST:-pvtest}}}}" \
		"$(date +%s)" "$level" "${PVTEST_LOG_SOURCE:-pvtest}" "$*")
	printf '%s\n' "$line"
	# When a test is active, mirror the message into its per-test test.log so the
	# log holds the whole test (setup -> script -> teardown), not just the script.
	# Unset on the host, where the mirror is a no-op.
	[ -n "$PVTEST_ACTIVE_TESTLOG" ] && printf '%s\n' "$line" >> "$PVTEST_ACTIVE_TESTLOG" 2>/dev/null
	return 0
}

# wait for a cmd exit status code
wait_for_status() {
	local cmd="$1"
	local status="$2"
	local timeout="$3"

	local counter=0
	while [ $counter -lt $timeout ]; do
		cmd_status=0
		eval "$cmd" || cmd_status=$?
		if [ "$cmd_status" = "$status" ]; then
			return 0
		else
			sleep 1
			counter=$((counter+1))
		fi
	done
	return 1
}

# SSH invocation to reach a pantavisor target's dropbear-pv.
# Bound connect/keepalive so polling across a reboot fails fast: reboot-class
# updates black-hole established TCP connections, and an ssh without keepalives
# blocks on them forever, wedging every wait_for_* loop on a single poll.
# usage: pvtest_ssh_cmd <host> [identity]
pvtest_ssh_cmd() {
	printf 'ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=3 -o ServerAliveCountMax=2 -i %s -p %s _pv_@%s' \
		"${2:-${PVTEST_SSH_KEY:-/tmp/pvtest_id}}" "${PVTEST_SSH_PORT:-8222}" "$1"
}

# Stable signature for a test's config.env: drop empties and PV_LXC_LOG_LEVEL,
# sort, join with single spaces. The host decides whether a slot needs re-typing
# by comparing these, and the tester repeats the comparison per test — the two
# must agree byte for byte or a re-type on one side won't match the other, which
# on a real device shows up as tests silently SKIPping instead of running.
pvtest_normalize_cfg() {
	printf '%s\n' $1 | grep -v '^$' | grep -v '^PV_LXC_LOG_LEVEL=' | sort | tr '\n' ' ' | sed 's/ *$//'
}

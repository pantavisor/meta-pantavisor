From 7f86f957633ee31a1c17a1eb8452ca7a3d9bc141 Mon Sep 17 00:00:00 2001
From: Roland Shoemaker <bracewell@google.com>
Date: Mon, 19 Oct 2026 14:20:28 -0700
Subject: [PATCH] crypto/x509: distrust a handful of intermediates

Filter a set of intermediates from chains returned by calls to Verify.
These chains are identified via SHA-256 SPKI hashes.

Fixes CVE-2026-111943
For golang/go#82345

Backported to go1.24.13, which has no upstream fix: Go 1.24 is past its
support window. Go 1.24's Verify filters chains with a loop rather than
slices.DeleteFunc, so a chain with a distrusted certificate is dropped in
the policy loop, as upstream drops it alongside the chains with invalid
policies.

CVE: CVE-2026-111943
Upstream-Status: Backport [https://go.dev/cl/851047]
Signed-off-by: Sergio Marin <sergio.marin@pantacor.com>
---
diff --git a/src/crypto/x509/root_darwin.go b/src/crypto/x509/root_darwin.go
index 469e907..32c8ebb 100644
--- a/src/crypto/x509/root_darwin.go
+++ b/src/crypto/x509/root_darwin.go
@@ -90,6 +90,10 @@ func (c *Certificate) systemVerify(opts *VerifyOptions) (chains [][]*Certificate
 		return nil, errors.New("x509: macOS certificate verification internal error")
 	}
 
+	if containsDistrustedSPKIHash(chain[0]) {
+		return nil, CertificateInvalidError{c, NoValidChains, ""}
+	}
+
 	if opts.DNSName != "" {
 		// If we have a DNS name, apply our own name verification
 		if err := chain[0][0].VerifyHostname(opts.DNSName); err != nil {
diff --git a/src/crypto/x509/root_windows.go b/src/crypto/x509/root_windows.go
index 4bea108..f2b90c3 100644
--- a/src/crypto/x509/root_windows.go
+++ b/src/crypto/x509/root_windows.go
@@ -7,6 +7,7 @@ package x509
 import (
 	"bytes"
 	"errors"
+	"slices"
 	"strings"
 	"syscall"
 	"unsafe"
@@ -268,7 +269,12 @@ func (c *Certificate) systemVerify(opts *VerifyOptions) (chains [][]*Certificate
 		}
 	}
 
+	chains = slices.DeleteFunc(chains, containsDistrustedSPKIHash)
+
 	if len(chains) == 0 {
+		if topErr == nil {
+			return nil, CertificateInvalidError{c, NoValidChains, ""}
+		}
 		// Return the error from the highest quality context.
 		return nil, topErr
 	}
diff --git a/src/crypto/x509/verify.go b/src/crypto/x509/verify.go
index 076e826..dca7298 100644
--- a/src/crypto/x509/verify.go
+++ b/src/crypto/x509/verify.go
@@ -7,7 +7,9 @@ package x509
 import (
 	"bytes"
 	"crypto"
+	"crypto/sha256"
 	"crypto/x509/pkix"
+	"encoding/hex"
 	"errors"
 	"fmt"
 	"iter"
@@ -886,7 +888,7 @@ func (c *Certificate) Verify(opts VerifyOptions) (chains [][]*Certificate, err e
 
 	var invalidPoliciesChains int
 	for _, candidate := range candidateChains {
-		if !policiesValid(candidate, opts) {
+		if !policiesValid(candidate, opts) || containsDistrustedSPKIHash(candidate) {
 			invalidPoliciesChains++
 			continue
 		}
@@ -1662,3 +1664,29 @@ func policiesValid(chain []*Certificate, opts VerifyOptions) bool {
 
 	return true
 }
+
+// distrustedSPKIHashes contains hashes of SPKIs from certificates which
+// we don't consider to be trustworthy. We use these hashes to filter out
+// chains returned by Verify
+var distrustedSPKIHashes = map[string]struct{}{
+	"ebed6475c2c2d80fcb199f3fe8dd6e6b3ce60b77eb15d4e42c3dec0c6f5b5105": {},
+	"49dd353dc2b919a3770645117d0e60c16115e7d1bc259eefe734b00ea434fe5f": {},
+	"e0254c7fcdc265e2f0f8a428dabb75ab4ae039b4872d62f5ee57f0877d5a8a41": {},
+	"5c0660a2b164910d8ff589c18e14552e9e0ec237dcefe2cb736d41a4811f81a0": {},
+	"43bffa19d6ef651451f6841e019931e96f6f2eaeff28ab4b6f1ce4576de2717b": {},
+	"63ecefee431d49523bc1136c4e72d0206a477086caf606cd5cf025686c109cf8": {},
+	"ec4ffa1ad0ac88081314b7aaffef6a91f97cd57291bb5ba686c5415f5eb4f6b6": {},
+	"92c063d67e8f14db71d288e11266ffdaf69cbf115f7bab14f3bc2f68d25e0e30": {},
+}
+
+// containsDistrustedSPKIHash checks if any of the certificates in the chain
+// have an SPKI whose hash is present in the distrustedSPKIHashes map.
+func containsDistrustedSPKIHash(chain []*Certificate) bool {
+	for _, c := range chain {
+		h := sha256.Sum256(c.RawSubjectPublicKeyInfo)
+		if _, ok := distrustedSPKIHashes[hex.EncodeToString(h[:])]; ok {
+			return true
+		}
+	}
+	return false
+}

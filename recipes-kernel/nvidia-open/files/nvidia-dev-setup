#!/bin/sh
# Create the /dev/nvidia* nodes CUDA opens. The modules register only char
# majors, no device nodes; on a desktop nvidia-modprobe or the container
# toolkit mknods them. Pantavisor loads the modules (PV_DRIVERS_REQUIRED), so
# this only creates the nodes, from the majors in /proc/devices.
#
# It also refuses a userspace from another driver release than the loaded
# module: libcuda fails such a pairing with an unhelpful CUDA_ERROR, so name it.
# The release is read from beside this script, so the check holds wherever the
# userspace is mounted (the BSP's driver volume at /usr/local/nvidia).

set -e

expected="$(cat "$(dirname "$0")/../share/nvidia/driver-version" 2>/dev/null || true)"

if [ ! -r /proc/driver/nvidia/version ]; then
	echo "nvidia-dev-setup: nvidia module not loaded; is \"nvidia\" in PV_DRIVERS_REQUIRED?" >&2
	exit 1
fi
# "NVRM version: NVIDIA UNIX Open Kernel Module for aarch64  580.178.04  Release Build ..."
loaded="$(awk '/^NVRM/ { for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+\.[0-9]+(\.[0-9]+)?$/) { print $i; exit } }' /proc/driver/nvidia/version)"
if [ -n "$expected" ] && [ "$loaded" != "$expected" ]; then
	echo "nvidia-dev-setup: kernel module is $loaded, the driver userspace is $expected; they must come from the same BSP" >&2
	exit 1
fi

major() {
	awk -v n="$1" '$2 == n { print $1 }' /proc/devices
}

node() {
	[ -c "$1" ] || mknod -m 666 "$1" c "$2" "$3"
}

# NVIDIA's reserved major (nv-chardev-numbers.h); 255 is the control device,
# 254 nvidia-modeset, 0-247 the GPUs. Only nvidia-uvm's major is dynamic.
frontend=195

node /dev/nvidiactl "$frontend" 255
i=0
for gpu in /proc/driver/nvidia/gpus/*; do
	[ -e "$gpu" ] || continue
	node /dev/nvidia$i "$frontend" $i
	i=$((i + 1))
done
[ $i -gt 0 ] || { echo "nvidia-dev-setup: the module found no GPU" >&2; exit 1; }

if grep -q '^nvidia_modeset ' /proc/modules; then
	node /dev/nvidia-modeset "$frontend" 254
fi

uvm="$(major nvidia-uvm)"
if [ -n "$uvm" ]; then
	node /dev/nvidia-uvm "$uvm" 0
	node /dev/nvidia-uvm-tools "$uvm" 1
else
	echo "nvidia-dev-setup: nvidia-uvm not loaded; CUDA needs it" >&2
	exit 1
fi

echo "nvidia-dev-setup: driver $loaded, $i GPU(s)"

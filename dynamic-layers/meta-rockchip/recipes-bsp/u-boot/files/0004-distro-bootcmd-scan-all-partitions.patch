From d4c49802518a8efd2e7bc46126edaf885399c7f2 Mon Sep 17 00:00:00 2001
From: Fernando Luiz Cola <fernando.luiz@pantacor.com>
Date: Tue, 25 Aug 2026 12:06:53 -0300
Subject: [PATCH] distro_bootcmd: scan every partition when none is marked
 bootable

scan_dev_for_boot_part looks for partitions carrying the legacy BIOS
bootable attribute and, finding none, falls back to partition 1 alone.
On a layout whose partition 1 is a raw bootloader region rather than a
filesystem, that fallback can never succeed and the board drops through
to PXE.

Relying on the attribute is fragile: anything that rewrites the
partition table may drop it. pantavisor's own autogrow does exactly
that -- pv_e2fsgrow deletes and recreates the rootfs partition to fill
the medium, preserving its name and GUID but not its attribute flags,
so a board boots once from a freshly flashed image and then fails on
the next boot.

Enumerate all partitions as an intermediate fallback before giving up
on partition 1. The existing fstype check already skips partitions
holding no filesystem, so this only widens where a boot script may be
found.

Signed-off-by: Fernando Luiz Cola <fernando.luiz@pantacor.com>
---
 include/config_distro_bootcmd.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/include/config_distro_bootcmd.h b/include/config_distro_bootcmd.h
index 9ed6b98..b8c6df2 100644
--- a/include/config_distro_bootcmd.h
+++ b/include/config_distro_bootcmd.h
@@ -369,6 +369,8 @@
 	\
 	"scan_dev_for_boot_part="                                         \
 		"part list ${devtype} ${devnum} -bootable devplist; "     \
+		"env exists devplist || "                                 \
+			"part list ${devtype} ${devnum} devplist; "       \
 		"env exists devplist || setenv devplist 1; "              \
 		"for distro_bootpart in ${devplist}; do "                 \
 			"if fstype ${devtype} "                           \

From 4a209ed4e83e5771fa79ef3f9163fe1764accf57 Mon Sep 17 00:00:00 2001
From: Fernando Luiz Cola <fernando.luiz@pantacor.com>
Date: Mon, 14 Sep 2026 16:35:13 -0300
Subject: [PATCH] vendor: look up protobuf in module mode only

protobuf's own protobuf-config.cmake exports a protobuf::protoc imported
target whose location is the protoc that ships alongside libprotobuf. In a
cross build that is a target-architecture binary, and protobuf_generate_cpp
then tries to execute it on the build host. CMake's FindProtobuf module
honours Protobuf_PROTOC_EXECUTABLE instead, so drop the config-mode lookup
and let the build pass in the build host's protoc.

Upstream-Status: Inappropriate [cross-compile specific]

Signed-off-by: Fernando Luiz Cola <fernando.luiz@pantacor.com>
---
 vendor/CMakeLists.txt | 1 -
 1 file changed, 1 deletion(-)

diff --git a/vendor/CMakeLists.txt b/vendor/CMakeLists.txt
index 47d53eb..54003b0 100644
--- a/vendor/CMakeLists.txt
+++ b/vendor/CMakeLists.txt
@@ -101,7 +101,6 @@ else()
 endif()
 pkg_check_modules(libzstd REQUIRED IMPORTED_TARGET libzstd)
 
-find_package(Protobuf CONFIG)
 find_package(Protobuf REQUIRED)
 set(THREADS_PREFER_PTHREAD_FLAG ON)
 find_package(Threads REQUIRED)
-- 

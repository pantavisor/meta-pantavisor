{
  "#spec": "service-manifest-xconnect@1",
  "services": [
    {
      "type": "dbus",
      "bus": "system-bus",
      "owns": "org.freedesktop.Avahi",
      "role": "avahi-service",
      "allow": [
        "operator",
        "monitor",
        {
          "role": "avahi-reader",
          "interfaces": ["org.freedesktop.Avahi.Server"],
          "members": ["GetVersionString"]
        }
      ],
      "activation": {
        "mode": "on-demand"
      }
    }
  ],
  "roles": {
    "avahi-service": {
      "uid": 4242
    }
  }
}
